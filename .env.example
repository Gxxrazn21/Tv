# Copia este fichero como backend/.env y rellena los valores. NUNCA subas .env al repositorio.

# Base de datos. Desarrollo: SQLite. Producción: PostgreSQL (instala el extra "postgres").
OPENFOOT_DATABASE_URL=sqlite:///./openfoot.db
# OPENFOOT_DATABASE_URL=postgresql+psycopg://openfoot:CAMBIA_ESTO@localhost:5432/openfoot

# Fuente principal: clave gratuita de https://www.football-data.org/client/register
OPENFOOT_FOOTBALL_DATA_TOKEN=
OPENFOOT_FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1,CL,DED,PPL,ELC,BSA,WC,EC
# Mantener por debajo del límite publicado del plan (10/min en el plan gratuito).
OPENFOOT_FOOTBALL_DATA_REQUESTS_PER_MINUTE=8

# Fuente secundaria sin clave (Bundesliga y 2. Bundesliga).
OPENFOOT_OPENLIGADB_ENABLED=true
OPENFOOT_OPENLIGADB_LEAGUES=bl1,bl2

# Sincronización periódica dentro del servidor.
OPENFOOT_SCHEDULER_ENABLED=false
OPENFOOT_SYNC_INTERVAL_MINUTES=15

# Una verificación de derechos caduca a los N días y deja de mostrarse.
OPENFOOT_VERIFICATION_TTL_DAYS=30

# Servir URL de escudos (marcas registradas). Desactivado salvo que tengas permiso.
OPENFOOT_SERVE_CREST_URLS=false

# Límite de solicitudes por cliente y minuto.
OPENFOOT_RATE_LIMIT_PER_MINUTE=120
# Activar solo detrás de un proxy inverso de confianza que fije X-Forwarded-For.
OPENFOOT_TRUST_FORWARDED_FOR=false
